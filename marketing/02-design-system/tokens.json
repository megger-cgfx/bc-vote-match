{
  "meta": {
    "name": "BC Vote Match — core design tokens",
    "version": "1.0.0",
    "status": "draft for human review",
    "date": "2026-10-01",
    "owner": "eagle (M8 design system)",
    "source_of_truth": true,
    "note": "This file is the single source of truth for colour, type, space, radius, border width, elevation, z-index and motion. No other file in the M8 design system may contain a raw hex or px value.",
    "neutrality": "The product is neutral by design: the UI palette is greyscale plus one accent. Party colours are never page-level framing and appear only as small swatches inside result views. Nothing in this token set may be re-mapped to a party colour.",
    "conventions": {
      "syntax": "dot.path.lower-kebab — groups and token names are lower-kebab; nesting depth is expressed with dots (color.brand.primary, space.4).",
      "leaf_shape": "Every leaf is an object with at least 'value' and 'type'. Colour leaves add 'intent' and 'contrast'. Dimension leaves add 'intent'.",
      "types": ["color", "dimension", "number", "fontFamily", "fontWeight", "duration", "cubicBezier", "shadow"],
      "units": "Dimensions are strings with an explicit unit ('16px', '0.25rem' is NOT used — px is canonical). Line-height is unitless. Letter-spacing is in em. Durations are in ms.",
      "aliases": "A leaf may carry 'aliasOf' when it intentionally mirrors another token. Mirrored pairs must be updated together; consolidation must not treat them as duplicates.",
      "contrast": "Each colour leaf lists its intended pairing(s) with the WCAG 2.1 ratio and level computed against the 0-255 sRGB sRGB-linear formula. Backgrounds list the text token that is intended to sit on them, as {'against': '<name> = the text/foreground colour'}.",
      "accessibility_baseline": "WCAG 2.1 AA. Body text >= 4.5:1, large text (>=24px or >=18.66px bold) >= 3:1, non-text UI boundaries (focus rings, input borders, icons) >= 3:1. Disabled text is exempt but must not be the only signal of state."
    }
  },

