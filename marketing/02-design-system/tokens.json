    "body-lg":     {"fontFamily": "font.family.sans", "fontSize": "font.size.lg", "fontWeight": "font.weight.regular", "lineHeight": 1.556, "letterSpacing": "0em", "color": "color.text.secondary", "background": "color.surface.canvas", "intent": "Lead paragraph."},
    "body":        {"fontFamily": "font.family.sans", "fontSize": "font.size.md", "fontWeight": "font.weight.regular", "lineHeight": 1.5, "letterSpacing": "0em", "color": "color.text.primary", "background": "color.surface.canvas", "intent": "Default body copy."},
    "body-sm":     {"fontFamily": "font.family.sans", "fontSize": "font.size.sm", "fontWeight": "font.weight.regular", "lineHeight": 1.429, "letterSpacing": "0em", "color": "color.text.secondary", "background": "color.surface.canvas", "intent": "Secondary body, help text."},
    "label":       {"fontFamily": "font.family.sans", "fontSize": "font.size.sm", "fontWeight": "font.weight.medium", "lineHeight": 1.429, "letterSpacing": "0em", "color": "color.text.secondary", "background": "color.surface.default", "intent": "Form labels, button text, table headers."},
    "caption":     {"fontFamily": "font.family.sans", "fontSize": "font.size.xs", "fontWeight": "font.weight.regular", "lineHeight": 1.334, "letterSpacing": "0.01em", "color": "color.text.muted", "background": "color.surface.canvas", "intent": "Metadata, source citations, footnotes."},
    "code":        {"fontFamily": "font.family.mono", "fontSize": "font.size.sm", "fontWeight": "font.weight.regular", "lineHeight": 1.429, "letterSpacing": "0em", "color": "color.text.primary", "background": "color.surface.sunken", "intent": "Code and aligned numeric columns."},
    "link":        {"fontFamily": "font.family.sans", "fontSize": "font.size.md", "fontWeight": "font.weight.regular", "lineHeight": 1.5, "letterSpacing": "0em", "color": "color.text.link", "background": "color.surface.canvas", "intent": "Inline link; always underlined in addition to colour."}
  },

  "space": {
    "_note": "4px base scale. space.<n> = n * 4px, so the index is always the number of 4px units. space.1 = 4px, space.4 = 16px, space.6 = 24px. Never write a padding/margin/gap as a literal.",
    "0":  {"value": "0px",   "type": "dimension", "intent": "Collapse (no space)."},
    "1":  {"value": "4px",   "type": "dimension", "intent": "Hairline gap: icon-to-label, inline badge padding."},
    "2":  {"value": "8px",   "type": "dimension", "intent": "Base unit: compact gap, input padding-block."},
    "3":  {"value": "12px",  "type": "dimension", "intent": "Default control padding, list-row gap."},
    "4":  {"value": "16px",  "type": "dimension", "intent": "Default padding inside cards; standard gap."},
    "5":  {"value": "20px",  "type": "dimension", "intent": "Comfortable control padding."},
    "6":  {"value": "24px",  "type": "dimension", "intent": "Section gap, card padding (large)."},
    "8":  {"value": "32px",  "type": "dimension", "intent": "Gap between blocks."},
    "10": {"value": "40px",  "type": "dimension", "intent": "Gap between sections."},
    "12": {"value": "48px",  "type": "dimension", "intent": "Page section vertical rhythm (small viewport)."},
    "16": {"value": "64px",  "type": "dimension", "intent": "Page section vertical rhythm (large viewport)."},
    "20": {"value": "80px",  "type": "dimension", "intent": "Hero spacing."},
    "24": {"value": "96px",  "type": "dimension", "intent": "Maximum section separation."},
    "32": {"value": "128px", "type": "dimension", "intent": "Full-bleed hero top/bottom."}
  },

  "radius": {
    "_note": "Corner rounding. Applied consistently: controls use sm, containers use lg, pills/badges use full.",
    "none": {"value": "0px",    "type": "dimension", "intent": "Sharp corners: tables, full-bleed sections."},
    "xs":   {"value": "2px",    "type": "dimension", "intent": "Badges, tags, inline code."},
    "sm":   {"value": "4px",    "type": "dimension", "intent": "Buttons, inputs, checkboxes, focus ring."},
    "md":   {"value": "6px",    "type": "dimension", "intent": "Small cards, dropdowns, tooltips."},
    "lg":   {"value": "8px",    "type": "dimension", "intent": "Cards, panels."},
    "xl":   {"value": "12px",   "type": "dimension", "intent": "Modals, large media containers."},
    "2xl":  {"value": "16px",   "type": "dimension", "intent": "Hero media, app shell."},
    "full": {"value": "9999px", "type": "dimension", "intent": "Pills, avatars, circular icon buttons."}
  },

  "border": {
    "width": {
      "_note": "Geometry namespace. Border colours live under color.border.",
      "none":    {"value": "0px", "type": "dimension", "intent": "Borderless (pair with a surface or shadow to keep separation)."},
      "thin":    {"value": "1px", "type": "dimension", "intent": "Hairlines, dividers, resting control borders."},
      "default": {"value": "1px", "type": "dimension", "intent": "Alias of thin — the value to use for input/card boundaries in prose specs."},
      "thick":   {"value": "2px", "type": "dimension", "intent": "Selected/active boundary on inputs and table rows."},
      "focus":   {"value": "3px", "type": "dimension", "intent": "Focus-visible ring, drawn with outline-offset 2px."}
    },
    "style": {
      "solid": {"value": "solid", "type": "string", "intent": "Default for every border."},
      "dashed": {"value": "dashed", "type": "string", "intent": "Drop targets and unverified/placeholder rows only."}
    },
    "focus-offset": {
      "value": "2px",
      "type": "dimension",
      "intent": "outline-offset for the focus-visible ring, so the ring never sits on top of the control's own border."
    }
  },

  "shadow": {
    "_note": "Elevation. Light and dark variants per level; dark surfaces need a heavier shadow to read as raised. Never use a level for decoration — each maps to a specific stacking intent.",
    "elevation-0": {"value": "none", "type": "shadow", "dark": "none", "intent": "Flush content, no lift."},
    "elevation-1": {"value": "0 1px 2px rgba(20, 23, 28, 0.06)", "type": "shadow", "dark": "0 1px 2px rgba(0, 0, 0, 0.40)", "intent": "Card resting on canvas."},
    "elevation-2": {"value": "0 2px 8px rgba(20, 23, 28, 0.08)", "type": "shadow", "dark": "0 2px 8px rgba(0, 0, 0, 0.50)", "intent": "Dropdown, popover, sticky header."},
    "elevation-3": {"value": "0 8px 24px rgba(20, 23, 28, 0.12)", "type": "shadow", "dark": "0 8px 24px rgba(0, 0, 0, 0.60)", "intent": "Modal/dialog, drawer."},
    "elevation-4": {"value": "0 12px 32px rgba(20, 23, 28, 0.16)", "type": "shadow", "dark": "0 12px 32px rgba(0, 0, 0, 0.68)", "intent": "Toast and command palette — the highest layer."},
    "focus-ring":  {"value": "0 0 0 3px rgba(31, 78, 121, 0.45)", "type": "shadow", "dark": "0 0 0 3px rgba(158, 203, 240, 0.55)", "intent": "Optional halo combined with border.width.focus where an outline alone is clipped."}
  },

  "z": {
    "_note": "Stacking layers. Use these constants only; never a literal z-index.",
    "base":     {"value": 0,    "type": "number", "intent": "Document flow."},
    "content":  {"value": 1,    "type": "number", "intent": "Locally lifted content inside a stacking context."},
    "sticky":   {"value": 100,  "type": "number", "intent": "Sticky headers and sidebars."},
    "dropdown": {"value": 200,  "type": "number", "intent": "Menus, select popovers, autocomplete."},
    "overlay":  {"value": 300,  "type": "number", "intent": "Scrim/backdrop behind a modal."},
    "modal":    {"value": 400,  "type": "number", "intent": "Dialogs and drawers."},
    "toast":    {"value": 500,  "type": "number", "intent": "Transient notifications."},
    "tooltip":  {"value": 600,  "type": "number", "intent": "Tooltips — must sit above everything."},
    "max":      {"value": 9999, "type": "number", "intent": "Escape hatch for dev overlays only."}
  },

  "motion": {
    "duration": {
      "_note": "Milliseconds. Durations shorten automatically under prefers-reduced-motion (see reduced-motion).",
      "instant": {"value": 0,   "type": "duration", "intent": "State changes that must not animate (colour swaps on focus)."},
      "fast":    {"value": 100, "type": "duration", "intent": "Hover, focus, small colour transitions."},
      "base":    {"value": 200, "type": "duration", "intent": "Default: fades, small moves."},
      "slow":    {"value": 300, "type": "duration", "intent": "Dropdowns, drawers, expanding sections."},
      "slower":  {"value": 500, "type": "duration", "intent": "Modal enter/exit, page-level transitions."}
    },
    "easing": {
      "standard":   {"value": "cubic-bezier(0.2, 0, 0, 1)",     "type": "cubicBezier", "intent": "Default for anything that both enters and leaves."},
      "decelerate": {"value": "cubic-bezier(0.05, 0.7, 0.1, 1)", "type": "cubicBezier", "intent": "Entrances — fast in, gentle stop."},
      "accelerate": {"value": "cubic-bezier(0.3, 0, 0.8, 0.15)", "type": "cubicBezier", "intent": "Exits — gentle start, fast out."},
      "linear":     {"value": "linear",                          "type": "cubicBezier", "intent": "Progress bars and looping spinners only."}
    },
    "reduced-motion": {
      "value": "prefers-reduced-motion: reduce",
      "type": "query",
      "intent": "All animation and transition durations collapse to 0.01ms and looping animation stops. This overrides every duration token above."
    }
  }
}
